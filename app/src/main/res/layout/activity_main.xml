<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0D10"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ODP OFFICE"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="OpenDailyPacks · Zentrale"
            android:textColor="#A8AFB8"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:background="#171B21"
            android:padding="18dp"
            android:text="HEUTE\n0 offene Bestellungen   ·   0 Versandbereit\n0,00 € Umsatz"
            android:textColor="#FFFFFF"
            android:textSize="17sp" />

        <Button
            android:id="@+id/ordersButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="20dp"
            android:text="BESTELLUNGEN"
            android:textAllCaps="false"
            android:textSize="17sp" />

        <Button
            android:id="@+id/inventoryButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:text="BESTAND"
            android:textAllCaps="false"
            android:textSize="17sp" />

        <Button
            android:id="@+id/shippingButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:text="VERSAND &amp; LABELS"
            android:textAllCaps="false"
            android:textSize="17sp" />

        <Button
            android:id="@+id/financeButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:text="FINANZEN"
            android:textAllCaps="false"
            android:textSize="17sp" />

        <Button
            android:id="@+id/integrationsButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:text="SCHNITTSTELLEN"
            android:textAllCaps="false"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:padding="16dp"
            android:text="System bereit · ODP Office v0.1"
            android:textColor="#B8C0C8"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
